---
import Base from "../layouts/Base.astro";
import { db } from "../lib/db.js";
import { getBestXI, getSummary } from "../lib/queries.js";
import { playerImage, initials } from "../lib/avatar.js";

const MIN_MINUTES = 450;
const summary = getSummary(db);
const { xi, filled } = getBestXI(db, { minMinutes: MIN_MINUTES });

// Group the flat slot list into pitch lines (back to front).
const bySlot = (slot) => xi.filter((s) => s.slot === slot);
const lines = [
  [...bySlot("ST"), ...bySlot("W")].length ? [bySlot("W")[0], bySlot("ST")[0], bySlot("W")[1]] : [],
  bySlot("MID"),
  [...bySlot("CB"), ...bySlot("FB")],
  bySlot("GK"),
].filter((l) => l.length);
---

<Base title="Best XI">
  <h1>The Atlas XI</h1>
  <p class="lede">
    The best footballers who are <strong>eligible for Morocco and still free to choose it</strong> — players
    the national team could still call up, because they haven't committed to a country yet — auto-picked
    into a 4-3-3 by a fair, league-adjusted rating. <a href="/about">How it works →</a>
  </p>
  <div class="stats">
    <div class="stat"><b>{summary.eligible}</b><span>eligible players</span></div>
    <div class="stat"><b>{summary.scored}</b><span>rated this season</span></div>
    <div class="stat"><b>16</b><span>leagues tracked</span></div>
  </div>

  {
    filled === 0 ? (
      <div class="empty">
        No rated eligible players yet. Populate the database with <code>npm run etl</code>, then
        rebuild. ({summary.eligible} eligible · {summary.scored} scored)
      </div>
    ) : (
      <>
        <div class="pitch">
          {lines.map((line) => (
            <div class="line">
              {line.map((s) => {
                const filledSlot = s && s.player;
                const Tag = filledSlot ? "a" : "div";
                return (
                  <Tag
                    class={`slot ${filledSlot ? "" : "empty-slot"}`}
                    href={filledSlot ? `/player/${s.player.id}` : undefined}
                  >
                    {filledSlot ? (
                      <>
                        {playerImage(s.player.sofascoreId) ? (
                          <img
                            class="photo"
                            src={playerImage(s.player.sofascoreId)}
                            alt={s.player.name}
                          />
                        ) : (
                          <span class="photo photo--initials">{initials(s.player.name)}</span>
                        )}
                        <span class="pos">{s.slot}</span>
                        <span class="name">{s.player.name}</span>
                        <span class="score">{s.player.score.toFixed(2)}</span>
                        <span class="club">{s.player.club ?? ""}</span>
                      </>
                    ) : (
                      <span class="pos">{s ? s.slot : ""}</span>
                    )}
                  </Tag>
                );
              })}
            </div>
          ))}
        </div>
        <p class="note">
          {filled}/11 slots filled · min {MIN_MINUTES} league minutes to qualify · tap a player for
          his breakdown. Score
          <span
            class="info"
            tabindex="0"
            data-tip="A fair rating: each match rating weighted by minutes, pulled toward a baseline for small samples, then multiplied by league strength. See How it works."
          >
            i
          </span>
          — not the raw match rating.
        </p>
      </>
    )
  }

  <style>
    .pitch {
      background: linear-gradient(180deg, #0a7a42, #006233);
      border: 1px solid rgba(0, 0, 0, 0.2);
      border-radius: 16px;
      padding: 2rem 1rem;
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
      box-shadow: var(--shadow);
    }
    .line {
      display: flex;
      justify-content: space-around;
      gap: 0.75rem;
    }
    .slot {
      background: rgba(255, 255, 255, 0.96);
      color: #16181d;
      border-radius: 12px;
      padding: 0.7rem 0.5rem;
      width: 148px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
      text-decoration: none;
      transition:
        transform 0.1s ease,
        box-shadow 0.1s ease;
    }
    a.slot:hover {
      transform: translateY(-3px);
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.3);
    }
    .slot.empty-slot {
      background: rgba(255, 255, 255, 0.18);
      color: rgba(255, 255, 255, 0.8);
      border: 1px dashed rgba(255, 255, 255, 0.5);
      min-height: 84px;
      justify-content: center;
    }
    .photo {
      width: 76px;
      height: 76px;
      border-radius: 50%;
      object-fit: cover;
      background: #eef0f2;
      margin-bottom: 0.4rem;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
    }
    .photo--initials {
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 1.5rem;
      color: var(--green);
    }
    .pos {
      font-size: 0.7rem;
      font-weight: 800;
      color: var(--red);
      letter-spacing: 0.03em;
    }
    .slot .name {
      font-weight: 700;
      font-size: 0.9rem;
      margin-top: 0.15rem;
    }
    .slot .score {
      font-weight: 800;
      color: var(--green);
      font-size: 1.05rem;
    }
    .slot .club {
      font-size: 0.72rem;
      color: var(--muted);
    }
    .note {
      color: var(--muted);
      font-size: 0.85rem;
      margin-top: 1rem;
    }
    @media (max-width: 640px) {
      .slot {
        width: 92px;
      }
    }
  </style>
</Base>
