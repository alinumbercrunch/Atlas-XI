---
import Base from "../layouts/Base.astro";
import { db } from "../lib/db.js";
import { getBrowsePlayers, getLeagues, getSummary, POSITIONS } from "../lib/queries.js";

const players = getBrowsePlayers(db);
const leagues = getLeagues(db);
const summary = getSummary(db);
const leagueName = Object.fromEntries(leagues.map((l) => [l.id, l.name]));
const fmtMv = (v) => (v ? "€" + (v / 1_000_000).toFixed(1).replace(/\.0$/, "") + "m" : "—");
---

<Base title="Browse & rank">
  <h1>Browse &amp; rank</h1>
  <p class="lede">
    Every eligible player, ranked by fair score. Filter by league and position. ({summary.eligible} eligible,
    {summary.review} in review.)
  </p>

  {
    players.length === 0 ? (
      <div class="empty">
        No rated players yet. Run <code>npm run etl</code> to populate, then rebuild.
      </div>
    ) : (
      <>
        <div class="filters">
          <label>
            League
            <select id="f-league">
              <option value="">All leagues</option>
              {leagues.map((l) => (
                <option value={l.id}>{l.name}</option>
              ))}
            </select>
          </label>
          <label>
            Position
            <select id="f-pos">
              <option value="">All positions</option>
              {POSITIONS.map((p) => (
                <option value={p}>{p}</option>
              ))}
            </select>
          </label>
          <span class="count" id="count">
            {players.length} players
          </span>
        </div>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>#</th>
                <th>Player</th>
                <th>Pos</th>
                <th>League</th>
                <th>Club</th>
                <th class="num">Score</th>
                <th class="num">Rating</th>
                <th class="num">Mins</th>
                <th class="num">Apps</th>
                <th class="num">Value</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {players.map((p, i) => (
                <tr data-league={p.leagueId ?? ""} data-pos={p.position ?? ""}>
                  <td class="rank">{i + 1}</td>
                  <td class="pname">
                    {p.name}
                    <span class="cz">{(p.citizenships || []).join(" · ")}</span>
                  </td>
                  <td>{p.position ?? "—"}</td>
                  <td>{leagueName[p.leagueId] ?? "—"}</td>
                  <td>{p.club ?? "—"}</td>
                  <td class="num score">{p.score.toFixed(2)}</td>
                  <td class="num">{p.wavg ? p.wavg.toFixed(2) : "—"}</td>
                  <td class="num">{p.minutes}</td>
                  <td class="num">{p.matches}</td>
                  <td class="num">{fmtMv(p.marketValue)}</td>
                  <td>
                    <span class={`badge ${p.status}`}>{p.status}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )
  }

  <script is:inline>
    const league = document.getElementById("f-league");
    const pos = document.getElementById("f-pos");
    const count = document.getElementById("count");
    const rows = Array.from(document.querySelectorAll("tbody tr"));
    function apply() {
      const l = league.value,
        p = pos.value;
      let shown = 0;
      for (const r of rows) {
        const ok = (!l || r.dataset.league === l) && (!p || r.dataset.pos === p);
        r.style.display = ok ? "" : "none";
        if (ok) shown++;
      }
      count.textContent = shown + " players";
    }
    league?.addEventListener("change", apply);
    pos?.addEventListener("change", apply);
  </script>

  <style>
    .filters {
      display: flex;
      gap: 1rem;
      align-items: end;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }
    label {
      display: flex;
      flex-direction: column;
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--muted);
      gap: 0.25rem;
    }
    select {
      padding: 0.45rem 0.6rem;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--card);
      color: var(--text);
      font-size: 0.9rem;
      font-weight: 600;
    }
    .count {
      margin-left: auto;
      color: var(--muted);
      font-weight: 700;
      font-size: 0.85rem;
    }
    .table-wrap {
      overflow-x: auto;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: var(--shadow);
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
    }
    th,
    td {
      padding: 0.6rem 0.75rem;
      text-align: left;
      white-space: nowrap;
    }
    thead th {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--muted);
      border-bottom: 2px solid var(--border);
    }
    tbody tr {
      border-bottom: 1px solid var(--border);
    }
    tbody tr:hover {
      background: rgba(193, 39, 45, 0.05);
    }
    .num {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }
    .rank {
      color: var(--muted);
      font-weight: 700;
    }
    .pname {
      font-weight: 700;
    }
    .pname .cz {
      display: block;
      font-weight: 500;
      font-size: 0.72rem;
      color: var(--muted);
    }
    td.score {
      font-weight: 800;
      color: var(--green);
    }
    .badge {
      font-size: 0.7rem;
      font-weight: 700;
      padding: 0.15rem 0.5rem;
      border-radius: 999px;
      text-transform: capitalize;
    }
    .badge.eligible {
      background: rgba(0, 98, 51, 0.15);
      color: var(--green);
    }
    .badge.review {
      background: rgba(193, 39, 45, 0.13);
      color: var(--red);
    }
  </style>
</Base>
