{
  "name": "atlas-xi",
  "version": "0.1.0",
  "private": true,
  "description": "Scouting platform for the Morocco national team — track uncapped players eligible for the Atlas Lions and rank them with a fair, minutes-weighted, league-adjusted rating.",
  "license": "UNLICENSED",
  "scripts": {
    "verify:sofascore": "node scrapers/sofascore/verify.js",
    "db:seed": "node db/seed.js",
    "tm:discover": "node scrapers/transfermarkt/run.js",
    "sofa:stats": "node scrapers/sofascore/run.js",
    "sofa:images": "node scrapers/sofascore/images.js",
    "rate": "node rating/run.js",
    "etl": "node etl/run.js",
    "web:dev": "astro dev --root web",
    "web:build": "astro build --root web",
    "web:preview": "astro preview --root web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.astro": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "astro": "^7.1.6",
    "axios": "^1.15.0",
    "better-sqlite3": "^12.8.0",
    "cheerio": "^1.2.0",
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "vitest": "^4.1.10"
  }
}
